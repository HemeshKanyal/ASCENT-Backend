# MongoDB connection string (local: mongodb://127.0.0.1:27017/ascent, or a MongoDB Atlas URI)
MONGO_URI=
# Long random string, at least 32 characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
PORT=5000
# Meal photo AI (POST /api/meal-photo). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model (default gemini-flash-latest) and the one used when it's overloaded
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Optional: meal AI calls per IP per hour (default 30)
MEAL_RATE_LIMIT=
